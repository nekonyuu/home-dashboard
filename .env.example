PAC_IMAGE=ghcr.io/nekonyuu/home-dashboard:latest
COZYTOUCH_USERNAME=
COZYTOUCH_PASSWORD=
# Optionnel : LG ThinQ (lave-linge, lave-vaisselle, frigo). THINQ_CLIENT_ID = uuid4 généré une fois et conservé.
THINQ_PAT=
THINQ_COUNTRY=FR
THINQ_CLIENT_ID=
# Plages d'heures creuses (heure de Paris), pour répartir le chauffage HC/HP sur la page Énergie
# OFF_PEAK_HOURS=01:38-06:38,14:08-17:08   (défaut ; « off » pour désactiver)
POLL_INTERVAL_SECONDS=300
DB_PATH=/data/pac.db
BACKUP_DIR=/data/backup
BACKUP_KEEP=14
RETENTION_DAYS_RAW=0
STATIC_DIR=/app/static
LOG_LEVEL=INFO
